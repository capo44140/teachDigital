# Configuration pnpm (frontend). Version de pnpm figée via "packageManager" dans package.json.
enable-pre-post-scripts=true
auto-install-peers=true
strict-peer-dependencies=false

# Les scripts de build autorisés (esbuild, sharp, @tailwindcss/oxide) sont listés
# dans package.json > pnpm.onlyBuiltDependencies.
scripts-prepend-node-path=true
