# Image frontend à partir d'un dist/ déjà construit en local (../deploy.ps1 / ../deploy-frontend.ps1).
# Contexte de build minimal : dist/, nginx.conf (cf. Dockerfile.prebuilt.dockerignore).
FROM nginx:alpine

# Copier la configuration Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copier les fichiers buildés (depuis le contexte local)
COPY dist /usr/share/nginx/html

# Exposer le port (nginx.conf écoute sur 80)
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:80/ || exit 1

# Commande de démarrage
CMD ["nginx", "-g", "daemon off;"]
