# ============================================================================
# Variables d'environnement côté FRONTEND (dossier frontend/) — copier en frontend/.env
# ============================================================================
# ⚠️ Toute variable préfixée VITE_ est intégrée en clair dans le JavaScript livré au
# navigateur : n'y mettez JAMAIS de secret (clé API, mot de passe, token...).
# Les clés des fournisseurs IA (OPENAI_API_KEY, GEMINI_API_KEY, GROQ_API_KEY,
# MISTRAL_API_KEY, DEEPSEEK_API_KEY, KIMI_API_KEY) se configurent UNIQUEMENT dans
# backend/.env (cf. backend/env.example).

# Configuration de l'application
VITE_APP_NAME=TeachDigital
VITE_APP_VERSION=1.0.0

# Développement (pnpm dev) : laisser vide pour passer par le proxy Vite (/api -> backend)
VITE_API_URL=
# Cible du proxy Vite en développement (défaut : http://127.0.0.1:3001)
# VITE_DEV_API_TARGET=http://127.0.0.1:3001

# Production (pnpm build) : URL publique du site qui relaie /api vers le backend
# (défaut défini dans src/services/apiService.js)
# VITE_API_URL_PROD=https://votre-domaine.example

# ============================================================================
# Scripts de maintenance de la racine (scripts/*.js) — accès direct PostgreSQL
# ============================================================================
# URL de connexion PostgreSQL
# Format: postgresql://username:password@host:port/database?sslmode=require
# DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/teachdigital

# Configuration alternative (si DATABASE_URL n'est pas définie)
DB_HOST=localhost
DB_DATABASE=teachdigital
DB_USERNAME=teachdigital
# OBLIGATOIRE si DATABASE_URL n'est pas définie (ne jamais committer la vraie valeur)
DB_PASSWORD=
DB_PORT=5432
DB_SSL=false
