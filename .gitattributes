# Playwright
*.webm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary

# Test results
test-results/** -diff -merge
playwright-report/** -diff -merge

# Coverage reports
coverage/** -diff -merge
*.lcov -diff -merge

# Lock files
# pnpm-lock.yaml garde un diff texte pour que les changements de dépendances soient
# relus en revue ; -merge : en cas de conflit, regénérer avec `pnpm install`.
pnpm-lock.yaml -merge
