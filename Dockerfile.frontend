# Build complet du frontend dans Docker (utilisé par docker-compose.app.yml).
# Le déploiement Synology (deploy.ps1) utilise Dockerfile.frontend.prebuilt avec un dist/ construit en local.

# Stage 1: Build — Vite 7 requiert Node ^20.19 || >=22.12
FROM node:22-alpine AS builder

# pnpm figé sur la version déclarée dans package.json ("packageManager")
RUN npm install -g pnpm@9.15.9

WORKDIR /app

# Copier les fichiers de dépendances
COPY package.json pnpm-lock.yaml .npmrc ./

# Installer les dépendances
RUN pnpm install --frozen-lockfile

# Copier le reste du code (filtré par .dockerignore : pas de node_modules, .env, .git, tests...)
COPY . .

# URL de l'API injectée au build par Vite (optionnelle, cf. src/services/apiService.js)
ARG VITE_API_URL_PROD

# Build l'application
RUN pnpm run build

# Stage 2: Production avec Nginx
FROM nginx:alpine

# Copier la configuration Nginx
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Copier les fichiers buildés
COPY --from=builder /app/dist /usr/share/nginx/html

# Exposer le port (nginx-frontend.conf écoute sur 80)
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:80/ || exit 1

# Commande de démarrage
CMD ["nginx", "-g", "daemon off;"]
