# Configuration de la stack tout-en-un docker-compose.app.yml
# Copier ce fichier en .env (à côté de docker-compose.app.yml) et remplir les valeurs.
# Le déploiement Synology actuel (deploy.ps1) utilise plutôt backend/.env
# (cf. backend/env.docker.example).

# Base de données PostgreSQL
POSTGRES_USER=teachdigital
# OBLIGATOIRE — générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=teachdigital

# Backend API
# OBLIGATOIRE (>= 32 caractères aléatoires) — générer avec : openssl rand -hex 32
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
# Chiffrement des clés IA enregistrées depuis l'interface parent.
# Recommandé (>= 32 caractères, différent de JWT_SECRET) : openssl rand -hex 32
# Ne plus jamais la changer ensuite. Vide = clé dérivée de JWT_SECRET.
AI_SETTINGS_KEY=
# Proxys de confiance pour l'IP client (X-Forwarded-For) : 1 = nginx du frontend seul (défaut)
# TRUST_PROXY=1

# Frontend : origine de l'API injectée au build (vide = même origine que la page, recommandé)
VITE_API_URL_PROD=
