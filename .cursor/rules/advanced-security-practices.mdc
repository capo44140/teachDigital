export const testPinSecurity = async () => {
  const testCases = [
    '1234',    // PIN séquentiel - doit échouer
    '1111',    // PIN répétitif - doit échouer
    '0000',    // PIN commun - doit échouer
    '12345',   // PIN trop long - doit échouer
    '123',     // PIN trop court - doit échouer
