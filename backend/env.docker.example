# Configuration Docker pour TeachDigital Backend (backend/docker-compose.yml)
# Copiez ce fichier en .env (à côté de docker-compose.yml, sur le NAS) et remplissez les valeurs.
# Ce fichier .env n'est jamais commité ni copié dans l'image (cf. .gitignore / .dockerignore).

# ============================================
# BASE DE DONNÉES POSTGRESQL EXTERNE
# ============================================
# IMPORTANT: Configurez l'accès à votre PostgreSQL existant

# Option 1: Utiliser les variables séparées (recommandé)
# DB_HOST=host.docker.internal            # PostgreSQL sur l'hôte Docker
# DB_HOST=nom-du-conteneur-postgresql     # conteneur sur le même réseau Docker
# DB_HOST=<ip-du-serveur-postgresql>      # autre machine
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-database-user
# OBLIGATOIRE
DB_PASSWORD=
DB_SSL=false

# Option 2: Utiliser l'URL complète (alternative)
# DATABASE_URL=postgresql://<db-user>:<db-password>@host.docker.internal:5432/teachdigital

# ============================================
# SÉCURITÉ
# ============================================
# Secret JWT pour signer les tokens — OBLIGATOIRE (docker compose refuse de démarrer sans).
# >= 32 caractères aléatoires, unique par environnement. Générer avec : openssl rand -hex 32
JWT_SECRET=

# Chiffrement des clés API IA enregistrées depuis l'interface (table ai_settings) — RECOMMANDÉ.
# >= 32 caractères aléatoires, différent de JWT_SECRET : openssl rand -hex 32
# Sans elle, la clé est dérivée de JWT_SECRET (changer JWT_SECRET rendrait les clés illisibles).
# Au premier démarrage avec cette variable, les clés existantes sont rechiffrées automatiquement.
# Ne plus la changer ensuite (sinon : ressaisir les clés API dans Configuration IA).
AI_SETTINGS_KEY=

# ============================================
# RÉSEAU / PROXY
# ============================================
# Le backend rejoint le réseau Docker « teachdigital » (créé par deploy.ps1) ; le nginx du
# conteneur frontend est le seul intermédiaire : 1 proxy de confiance pour X-Forwarded-For.
# (Défaut déjà posé par docker-compose.yml ; à ne changer que si un autre proxy s'intercale.)
# TRUST_PROXY=1

# ============================================
# API IA (Optionnel - pour la génération de quiz)
# ============================================
# Au moins une clé API est recommandée pour utiliser la génération de quiz
# Clés et modèles peuvent aussi être enregistrés depuis Configuration IA (prioritaire sur ce fichier).
# Modèle par provider (optionnel) : OPENAI_MODEL, GEMINI_MODEL, GROQ_MODEL, MISTRAL_MODEL, DEEPSEEK_MODEL, KIMI_MODEL
# Obtenez votre clé API OpenAI : https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Configuration Gemini : https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
# Configuration Groq : https://console.groq.com/keys
GROQ_API_KEY=
# Configuration Mistral
MISTRAL_API_KEY=
# Configuration Deepseek
DEEPSEEK_API_KEY=
# Configuration Kimi / Moonshot AI (API compatible OpenAI) : https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=
# Configuration OpenRouter (optionnel : la clé peut être enregistrée depuis Configuration IA) : https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# LLM local (LM Studio / Ollama) - optionnel
# URL base au format OpenAI compatible: http://IP:PORT/v1
LOCAL_LLM_URL=http://<ip-du-poste-llm>:1234/v1
LOCAL_LLM_MODEL=<nom-du-modele>
# Timeout LLM local (ms) par appel - borné à 170000 (170s)
LOCAL_LLM_TIMEOUT_MS=170000
# Délai global d'une requête de génération IA, tous providers confondus (< 180 s)
# AI_REQUEST_TIMEOUT_MS=170000

# ============================================
# MODE OCR
# ============================================
# "llm" = LLM Vision (GPT-4o, Gemini, LocalLLM) - meilleure qualité
# "tesseract" = Tesseract.js OCR classique - gratuit, hors-ligne
OCR_MODE=llm
# Tesseract : délai max par image ; langues (fra, eng) téléchargées au 1er OCR (accès Internet
# requis une fois) puis conservées dans le volume .cache/tesseract (TESSERACT_CACHE_VOLUME)
# OCR_TIMEOUT_MS=60000

# ============================================
# CONFIGURATION CORS
# ============================================
# URL du frontend pour autoriser les requêtes CORS
FRONTEND_URL=https://votre-domaine.example
ALLOWED_ORIGIN=

# ============================================
# PORTS (optionnel - valeurs par défaut)
# ============================================
# Port publié UNIQUEMENT sur 127.0.0.1 du NAS (healthchecks) : le frontend passe par le réseau Docker
BACKEND_PORT=3001
# Volumes (défauts : sous-dossiers du dossier de déploiement)
# LOGS_VOLUME=./logs
# TESSERACT_CACHE_VOLUME=./.cache/tesseract

# ============================================
# BASE DE DONNÉES : DÉMARRAGE ET POOL
# ============================================
# Le serveur attend PostgreSQL (redémarrage du NAS) jusqu'à DB_STARTUP_TIMEOUT_MS, applique les
# migrations (backend/migrations), puis écoute. Migration en échec = arrêt (code 1).
# DB_STARTUP_TIMEOUT_MS=300000
# DB_MAX_CONNECTIONS=20
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=10000
# Arrêt propre (docker stop) : attente max des requêtes en cours (< stop_grace_period de 30 s)
# SHUTDOWN_TIMEOUT_MS=15000
# DB_PORT est défini ci-dessus

# ============================================
# ENVIRONNEMENT
# ============================================
NODE_ENV=production
