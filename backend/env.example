# Configuration du backend (développement local) — copier en backend/.env
# Ne jamais committer de vraies valeurs (backend/.env est ignoré par git).

# Configuration de la base de données PostgreSQL
# Méthode 1 : Variables séparées (recommandée, prioritaire si les 4 sont définies)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teachdigital
DB_USER=teachdigital
# OBLIGATOIRE — mot de passe de l'utilisateur PostgreSQL
DB_PASSWORD=
DB_SSL=false

# Méthode 2 : Connection string (alternative)
# Format: postgresql://username:password@host:port/database?sslmode=require
# DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/teachdigital

# Pool PostgreSQL et timeouts (valeurs par défaut)
# DB_MAX_CONNECTIONS=20               # connexions max du pool
# DB_CONNECTION_TIMEOUT_MS=5000       # attente max d'une connexion (création ou file d'attente)
# DB_STATEMENT_TIMEOUT_MS=10000       # PostgreSQL annule une requête plus longue (> API_DB_TIMEOUT_LONG_MS)
# DB_IDLE_TIMEOUT_MS=30000            # fermeture des connexions inactives
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# Démarrage : attente max de PostgreSQL (redémarrage du NAS) avant d'abandonner (code 1)
# DB_STARTUP_TIMEOUT_MS=300000
# Migrations (backend/migrations, appliquées au démarrage) : attente max d'un verrou de table
# MIGRATION_LOCK_WAIT_MS=60000

# Clé secrète pour signer les JWT — OBLIGATOIRE, >= 32 caractères aléatoires.
# Générer avec : openssl rand -hex 32
#   (ou : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Chiffrement des clés API IA enregistrées depuis l'interface (table ai_settings).
# Recommandé : >= 32 caractères aléatoires, DIFFÉRENT de JWT_SECRET (openssl rand -hex 32).
# Sans cette variable, la clé de chiffrement est dérivée de JWT_SECRET (ancien comportement) :
# changer JWT_SECRET rendrait alors les clés enregistrées illisibles. Une fois définie, les clés
# existantes sont relues avec l'ancienne clé puis rechiffrées automatiquement. Ne plus la changer
# ensuite (sinon : ressaisir les clés API dans Configuration IA).
# AI_SETTINGS_KEY=

# Logging (stabilité prod)
# LOG_FORMAT=text|json (recommandé: json en prod)
LOG_FORMAT=json
# LOG_DEBUG=true active des logs plus verbeux
LOG_DEBUG=false
# LOG_ENABLE_FILE=false pour désactiver les fichiers (stdout seulement)
# LOG_ENABLE_FILE=true
# LOGS_DIR=/logs
# LOG_MAX_SIZE=10485760   # rotation des fichiers de log (octets)
# LOG_MAX_FILES=5

# Timeouts DB (middleware withQueryTimeout) - en millisecondes
# Ajustez selon votre infra (Synology/DB distante) ; garder < DB_STATEMENT_TIMEOUT_MS
API_DB_TIMEOUT_DEFAULT_MS=7000
API_DB_TIMEOUT_FAST_MS=3000
API_DB_TIMEOUT_STANDARD_MS=5000
API_DB_TIMEOUT_LONG_MS=9000

# Rate limiting (stabilité prod)
API_RATE_LIMIT_LOGIN_WINDOW_MS=60000
API_RATE_LIMIT_LOGIN_MAX=20
API_RATE_LIMIT_PIN_WINDOW_MS=60000
API_RATE_LIMIT_PIN_MAX=5
# Envoi de journaux d'audit (route publique) : par IP, et toutes IP confondues
# API_RATE_LIMIT_AUDIT_MAX=60
# API_RATE_LIMIT_AUDIT_GLOBAL_MAX=300

# Verrouillage après N codes PIN / codes familiaux incorrects, par (profil, IP)
API_PIN_LOCK_MAX_FAILURES=10
API_PIN_LOCK_WINDOW_MS=900000
# Verrouillage global d'un profil, toutes IP confondues
# API_PIN_LOCK_GLOBAL_MAX_FAILURES=100
# API_PIN_LOCK_GLOBAL_WINDOW_MS=3600000
# Cache du statut des profils / de la version des jetons (révocation prise en compte sous ce délai)
# AUTH_CACHE_TTL_MS=30000

# Durée des jetons : « famille » (code d'entrée) et « profil » (PIN parent)
JWT_FAMILY_EXPIRES_IN=24h
JWT_PROFILE_EXPIRES_IN=4h

# Limites d'envoi
# Corps JSON : 100 ko par défaut ; 10 Mo seulement pour les routes qui en ont besoin
# (pages de cours, leçons, image de profil, routes IA en JSON)
API_JSON_BODY_LIMIT=100kb
API_JSON_LARGE_BODY_LIMIT=10mb
# Fichiers des routes IA (multipart)
API_UPLOAD_MAX_FILE_BYTES=15728640
API_UPLOAD_MAX_FILES=10
API_UPLOAD_MAX_TOTAL_BYTES=26214400

# Proxys de confiance pour l'IP client (X-Forwarded-For), utilisée par le rate limiting.
# - Développement (défaut) : loopback (proxy Vite sur 127.0.0.1)
# - Docker derrière le nginx du frontend : 1 (valeur posée par docker-compose.yml)
# - Liste possible : TRUST_PROXY=loopback, 172.16.0.0/12
# TRUST_PROXY=loopback

# Arrêt propre (SIGTERM) : attente max des requêtes en cours
# SHUTDOWN_TIMEOUT_MS=15000

# Configuration CORS - URL du frontend autorisé
# Cette URL sera automatiquement ajoutée à la liste des origines autorisées
FRONTEND_URL=http://localhost:3000

# Origine supplémentaire autorisée (optionnel)
# Utilisez cette variable si vous avez plusieurs frontends ou domaines
# Format: URL unique ou plusieurs URLs séparées par des virgules
# Exemple: ALLOWED_ORIGIN=https://votre-domaine.example,https://www.votre-domaine.example
ALLOWED_ORIGIN=

# Clés API et modèles IA (optionnels, backend uniquement — jamais en VITE_*)
# Ils peuvent aussi être enregistrés depuis Configuration IA : la valeur de l'interface est prioritaire.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-8k
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# LLM local compatible OpenAI (LM Studio / Ollama) : URL et modèle aussi réglables depuis Configuration IA
# (http/https sur le réseau local ; adresses link-local / métadonnées cloud refusées)
# LOCAL_LLM_URL=http://<ip-du-poste-llm>:1234/v1
# LOCAL_LLM_MODEL=<nom-du-modele>
# Délai global d'une requête de génération IA (tous providers confondus, < 180 s)
# AI_REQUEST_TIMEOUT_MS=170000
# OCR_MODE=llm|tesseract
# Tesseract (OCR_MODE=tesseract) : délai max par image et dossier du cache des langues
# (défaut : backend/.cache/tesseract en local, /tesseract-cache en Docker)
# OCR_TIMEOUT_MS=60000
# TESSERACT_CACHE_DIR=
# Génération de pages de cours à partir de photos (LM Studio vision, OpenAI, Gemini ou OpenRouter)
# COURSE_PAGE_MAX_TOKENS=16000
# COURSE_PAGE_TIMEOUT_MS=540000

# Données des enfants (RGPD) : leçons, photos et textes envoyés à l'IA viennent des devoirs.
# Un service IA n'est utilisé que s'il est autorisé pour ces données. Par défaut : Mistral (UE)
# et LM Studio (local) seulement. Le choix fait dans Configuration IA est prioritaire ; sinon
# cette liste remplace la liste par défaut (OpenAI, Gemini, DeepSeek, Groq, Mistral, Kimi, OpenRouter).
# AI_CHILD_DATA_PROVIDERS=Mistral,OpenAI

# Limites des générations IA (coût et mémoire)
# - appels par jour aux services payants (tous sauf LM Studio) ; 0 = illimité
# AI_DAILY_CALL_LIMIT=200
# - générations par parent sur la fenêtre (ms)
# AI_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_WINDOW_MS=600000
# - générations simultanées (une page de cours garde ses photos en mémoire plusieurs minutes)
# AI_MAX_CONCURRENT=2
