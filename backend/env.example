# Configuration du backend (développement local) — copier en backend/.env
# Ne jamais committer de vraies valeurs (backend/.env est ignoré par git).

# Configuration de la base de données PostgreSQL
# Méthode 1 : Variables séparées (recommandée, prioritaire si les 4 sont définies)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teachdigital
DB_USER=teachdigital
# OBLIGATOIRE — mot de passe de l'utilisateur PostgreSQL
DB_PASSWORD=
DB_SSL=false

# Méthode 2 : Connection string (alternative)
# Format: postgresql://username:password@host:port/database?sslmode=require
# DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/teachdigital

# Clé secrète pour signer les JWT — OBLIGATOIRE, >= 32 caractères aléatoires.
# Générer avec : openssl rand -hex 32
#   (ou : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Logging (stabilité prod)
# LOG_FORMAT=text|json (recommandé: json en prod)
LOG_FORMAT=json
# LOG_DEBUG=true active des logs plus verbeux
LOG_DEBUG=false
# LOG_ENABLE_FILE=false pour désactiver les fichiers (stdout seulement)
# LOG_ENABLE_FILE=true
# LOGS_DIR=/logs

# Timeouts DB (middleware withQueryTimeout) - en millisecondes
# Ajustez selon votre infra (Synology/DB distante)
API_DB_TIMEOUT_DEFAULT_MS=7000
API_DB_TIMEOUT_FAST_MS=3000
API_DB_TIMEOUT_STANDARD_MS=5000
API_DB_TIMEOUT_LONG_MS=9000

# Rate limiting (stabilité prod)
API_RATE_LIMIT_LOGIN_WINDOW_MS=60000
API_RATE_LIMIT_LOGIN_MAX=20
API_RATE_LIMIT_PIN_WINDOW_MS=60000
API_RATE_LIMIT_PIN_MAX=30

# Verrouillage par profil après N codes PIN / codes familiaux incorrects (indépendant de l'IP)
API_PIN_LOCK_MAX_FAILURES=10
API_PIN_LOCK_WINDOW_MS=900000

# Durée des jetons : « famille » (code d'entrée) et « profil » (PIN parent)
JWT_FAMILY_EXPIRES_IN=24h
JWT_PROFILE_EXPIRES_IN=4h

# Limites d'envoi (fichiers des routes IA, corps JSON)
API_UPLOAD_MAX_FILE_BYTES=15728640
API_UPLOAD_MAX_FILES=10
API_UPLOAD_MAX_TOTAL_BYTES=26214400
API_JSON_BODY_LIMIT=10mb

# Proxies de confiance pour l'IP client (X-Forwarded-For) — défaut : réseaux privés
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Configuration CORS - URL du frontend autorisé
# Cette URL sera automatiquement ajoutée à la liste des origines autorisées
FRONTEND_URL=http://localhost:3000

# Origine supplémentaire autorisée (optionnel)
# Utilisez cette variable si vous avez plusieurs frontends ou domaines
# Format: URL unique ou plusieurs URLs séparées par des virgules
# Exemple: ALLOWED_ORIGIN=https://votre-domaine.example,https://www.votre-domaine.example
ALLOWED_ORIGIN=

# Clés API IA (optionnelles, backend uniquement — jamais en VITE_*)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# LLM local compatible OpenAI (LM Studio / Ollama)
# LOCAL_LLM_URL=http://<ip-du-poste-llm>:1234/v1
# LOCAL_LLM_MODEL=<nom-du-modele>
# OCR_MODE=llm|tesseract
