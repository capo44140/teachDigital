# Configuration de la base de données PostgreSQL
DB_HOST=your-db-host
DB_PORT=5433
DB_NAME=postgres
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SSL=false

# Clé secrète JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret

# URL du frontend (pour CORS)
FRONTEND_URL=https://your-domain.fr
ALLOWED_ORIGIN=https://your-domain.fr,https://localhost:3000

# LLM local (optionnel)
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=your-model-name

# Clés API IA (optionnel selon les providers utilisés)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
DEEPSEEK_API_KEY=sk-...
KIMI_API_KEY=sk-...

# Mode OCR : "llm" ou "tesseract"
OCR_MODE=tesseract

# Logging
LOG_FORMAT=json
LOG_DEBUG=false
LOGS_DIR=/logs
LOGS_VOLUME=/volume1/docker/teachdigital/backend/logs

# Timeouts DB (ms)
API_DB_TIMEOUT_DEFAULT_MS=7000
API_DB_TIMEOUT_FAST_MS=3000
API_DB_TIMEOUT_STANDARD_MS=5000
API_DB_TIMEOUT_LONG_MS=9000

# Rate limiting
API_RATE_LIMIT_LOGIN_WINDOW_MS=60000
API_RATE_LIMIT_LOGIN_MAX=20
API_RATE_LIMIT_PIN_WINDOW_MS=60000
API_RATE_LIMIT_PIN_MAX=5
