# Exemple minimal pour le frontend (copier en .env). Version commentée : env.example
# ⚠️ Les variables VITE_* sont publiques (intégrées au bundle) : aucun secret ici.

# Configuration de l'application
VITE_APP_NAME=TeachDigital
VITE_APP_VERSION=1.0.0

# URL de l'API backend en développement (vide = proxy Vite vers http://127.0.0.1:3001)
VITE_API_URL=

# URL de connexion base de données (scripts de maintenance de la racine uniquement)
# DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/teachdigital
